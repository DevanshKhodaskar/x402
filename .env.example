# AgentPay Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for development.
# NEVER commit real private keys or database passwords to version control.
# ==============================================================================

# Application URLs
APP_URL=http://localhost:3000
NODE_ENV=development

# Database Connection (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
# Leave empty for zero-dependency local development using the built-in resilient in-memory store.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentpay?schema=public

# Authentication Security (JWT Session Signing Key - min 32 chars)
AUTH_SECRET=agentpay-super-secret-jwt-key-2026-production-ready-min32bytes

# x402 Protocol Configuration
# Mode: "simulated" (Mode A - local deterministic test settlement, zero gas needed)
#       "testnet"   (Mode B - Base Sepolia live on-chain broadcast)
X402_MODE=simulated
X402_PROTOCOL_VERSION=2.0
X402_PAYMENT_SCHEME=exact
X402_NETWORK=eip155:84532

# Blockchain & Token Parameters (Base Sepolia)
BASE_SEPOLIA_RPC=https://sepolia.base.org
PAYMENT_TOKEN_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
PAYMENT_RECIPIENT_ADDRESS=0x70997970C51812dc3A010C7d01b50e0d17dc79C8

# Optional Server-Side Facilitator Broadcast Signer
# Required ONLY if X402_MODE=testnet for automated facilitator broadcasting.
# Keep empty in Mode A (simulated mode).
FACILITATOR_PRIVATE_KEY=

# Demonstration Service Unit Prices (in atomic USDC units, 10^-6 decimals)
# 10000 = $0.01 USDC | 20000 = $0.02 USDC | 50000 = $0.05 USDC
WEATHER_API_PRICE=10000
TEXT_ANALYSIS_API_PRICE=20000
PREMIUM_DATA_API_PRICE=50000
